{
  "name": "matgyeomung-cloudflare-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node scripts/test-reservation-pet-photos.mjs && node scripts/test-reservation-details.mjs && node scripts/test-owner-application-rejections.mjs && node scripts/test-profile-sync.mjs && node scripts/test-live-notifications.mjs && node scripts/test-canceled-retention.mjs && node scripts/test-profile-email.mjs && node scripts/test-store-share.mjs && node scripts/test-notification-bootstrap.mjs && node scripts/test-notification-context.mjs && node scripts/test-reservation-submitted.mjs && node scripts/test-diary-notification.mjs && node scripts/test-realtime.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:migrate": "wrangler d1 migrations apply dog_kindergarden_db",
    "d1:migrate:local": "wrangler d1 migrations apply dog_kindergarden_db --local",
    "test:auth": "node scripts/test-auth-permissions.mjs",
    "test:production": "node ../scripts/production-readonly-smoke.mjs",
    "crawl:seoul": "node scripts/crawl-store-details.mjs --region=서울 --limit=600",
    "crawl:seoul:local": "node scripts/crawl-store-details.mjs --region=서울 --limit=600 --apply-local",
    "scrape:naver-prices": "node scripts/scrape-naver-place-prices.mjs --limit=50",
    "scrape:naver-prices:local": "node scripts/scrape-naver-place-prices.mjs --limit=50 --apply-local",
    "crawl:images": "node scripts/crawl-store-images.mjs --limit=50",
    "crawl:images:local": "node scripts/crawl-store-images.mjs --limit=50 --apply-local",
    "crawl:enrichment": "node scripts/crawl-store-enrichment.mjs --limit=50",
    "crawl:enrichment:local": "node scripts/crawl-store-enrichment.mjs --limit=50 --apply-local",
    "crawl:prices": "node scripts/crawl-store-prices.mjs --limit=40",
    "crawl:prices:local": "node scripts/crawl-store-prices.mjs --limit=40 --apply-local",
    "ocr:prices:local": "node scripts/ocr-price-images-local.mjs --input=crawl-results/price-ocr-input-2026-10-01.json --limit=10 --apply-local"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "wrangler": "^4.154.0"
  }
}
